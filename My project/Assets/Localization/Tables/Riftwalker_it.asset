    m_Metadata:
      m_Items: []
  - m_Id: 7513927816
    m_Localized: '{0} nemici'
    m_Metadata:
      m_Items: []
  - m_Id: 7513927817
    m_Localized: "\xC8 arrivato il boss!"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927818
    m_Localized: Con la sua scorta
    m_Metadata:
