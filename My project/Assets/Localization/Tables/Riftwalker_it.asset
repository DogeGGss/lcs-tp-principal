    m_Localized: "<color=#F3F4F6>{0}</color>  Scegli     <color=#F3F4F6>\u2190 \u2192</color>  Sposta     <color=#F3F4F6>Invio</color>  Conferma"
    m_Metadata:
      m_Items: []
