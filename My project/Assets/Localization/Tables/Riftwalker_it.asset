    m_Metadata:
      m_Items: []
  - m_Id: 2722374379991053
    m_Localized: 'Il cosmetico che scegli, senza fortuna. Acquisti simulati: non si paga denaro reale.'
    m_Metadata:
      m_Items: []
  - m_Id: 2722374379991054
    m_Localized: Nuove offerte tra {0} h {1:00} min
    m_Metadata:
      m_Items: []
  - m_Id: 2722374379991055
    m_Localized: Ti mancano {0} cristalli
    m_Metadata:
      m_Items: []
  - m_Id: 2722374379991056
    m_Localized: "Compra \xB7 {0} cristalli"
    m_Metadata:
      m_Items: []
