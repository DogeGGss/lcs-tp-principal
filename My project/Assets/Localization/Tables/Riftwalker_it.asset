  - m_Id: 7534899986
    m_Localized: "Creazione della stanza\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899987
    m_Localized: Non esiste una stanza con quel codice.
    m_Metadata:
      m_Items: []
  - m_Id: 7534899988
    m_Localized: "Ingresso nella stanza\u2026"
    m_Metadata:
      m_Items: []
