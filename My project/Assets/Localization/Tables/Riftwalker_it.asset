    m_Metadata:
      m_Items: []
  - m_Id: 7513927705
    m_Localized: "Modalit\xE0 Invasione"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927706
    m_Localized: Sei sopravvissuto!
    m_Metadata:
      m_Items: []
  - m_Id: 7513927707
    m_Localized: Sei stato eliminato
    m_Metadata:
      m_Items: []
  - m_Id: 7513927708
    m_Localized: Giocatore
    m_Metadata:
      m_Items: []
  - m_Id: 7513927709
    m_Localized: Impossibile connettersi. Controlla la connessione.
    m_Metadata:
      m_Items: []
  - m_Id: 7513927710
    m_Localized: "Non \xE8 pi\xF9 possibile tornare a quella partita."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927711
    m_Localized: Invasione
    m_Metadata:
      m_Items: []
  - m_Id: 7513927712
