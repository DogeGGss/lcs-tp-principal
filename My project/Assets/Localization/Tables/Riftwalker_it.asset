  - m_Id: 7513927806
    m_Localized: Inutile con Alimentazione diretta
    m_Metadata:
      m_Items: []
  - m_Id: 7513927807
    m_Localized: Sostituisce la tua {0}. Arriva con le munizioni piene.
    m_Metadata:
      m_Items: []
  - m_Id: 7513927808
    m_Localized: "Va nel tuo spazio arma {0}, che \xE8 vuoto. Arriva con le munizioni piene."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927809
    m_Localized: Scelta del posto
    m_Metadata:
