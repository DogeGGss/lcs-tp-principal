    m_Metadata:
      m_Items: []
  - m_Id: 7513927713
    m_Localized: Scegli il tuo equipaggiamento
    m_Metadata:
      m_Items: []
  - m_Id: 7513927714
    m_Localized: Inizia tra
    m_Metadata:
      m_Items: []
  - m_Id: 7513927715
    m_Localized: Chiudi per ricomparire
    m_Metadata:
      m_Items: []
  - m_Id: 7513927716
    m_Localized: Puoi cambiare
    m_Metadata:
      m_Items: []
  - m_Id: 7513927717
    m_Localized: Combattete!
    m_Metadata:
      m_Items: []
  - m_Id: 7513927718
    m_Localized: "Modalit\xE0 Deathmatch  \xB7  Cambia solo l'aspetto"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927719
    m_Localized: Cambi equipaggiamento quando muori o appena ricompari
    m_Metadata:
      m_Items: []
