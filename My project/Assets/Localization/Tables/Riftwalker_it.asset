    m_Metadata:
      m_Items: []
  - m_Id: 7534900034
    m_Localized: I valori di questa scheda tornano a quelli di fabbrica e vengono salvati.
    m_Metadata:
      m_Items: []
  - m_Id: 7534900035
    m_Localized: Modifiche salvate
