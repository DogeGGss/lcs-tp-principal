    m_Localized: Copiato
    m_Metadata:
      m_Items: []
  - m_Id: 7534899990
    m_Localized: "Caricamento della partita\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899991
    m_Localized: Libero
    m_Metadata:
      m_Items: []
  - m_Id: 7534899992
    m_Localized: "  <color=#FFD2A1>\xB7 host</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899993
    m_Localized: "Non ci sono mappe per questa modalit\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899994
    m_Localized: "In attesa dell'host\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899995
    m_Localized: Passa il codice ai tuoi amici. Servono almeno 2 giocatori.
    m_Metadata:
      m_Items: []
  - m_Id: 7534899996
    m_Localized: 'Tutto pronto: avvia la partita quando vuoi.'
    m_Metadata:
      m_Items: []
