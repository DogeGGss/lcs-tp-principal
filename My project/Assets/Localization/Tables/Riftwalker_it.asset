  - m_Id: 7534899918
    m_Localized: Cerca partita
    m_Metadata:
      m_Items: []
  - m_Id: 7534899919
    m_Localized: " \xB7 con giocatori della tua regione"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899920
    m_Localized: "Stanza privata \xB7 con amici"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899921
    m_Localized: Crea stanza
    m_Metadata:
      m_Items: []
  - m_Id: 7534899922
    m_Localized: Entra con codice
    m_Metadata:
      m_Items: []
  - m_Id: 7534899923
    m_Localized: Cerca di nuovo
    m_Metadata:
      m_Items: []
  - m_Id: 7534899924
    m_Localized: Apri il launcher
    m_Metadata:
      m_Items: []
  - m_Id: 7534899925
    m_Localized: Giocatore
    m_Metadata:
      m_Items: []
  - m_Id: 7534899926
    m_Localized: Ricerca annullata.
    m_Metadata:
      m_Items: []
  - m_Id: 7534899927
    m_Localized: 'Non abbiamo trovato il launcher su questo PC: ti apriamo la guida del gioco per scaricarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 7534899928
    m_Localized: Annulla ricerca
    m_Metadata:
      m_Items: []
  - m_Id: 7534899929
    m_Localized: Esci dalla stanza
    m_Metadata:
      m_Items: []
  - m_Id: 7534899930
    m_Localized: "Torna alle modalit\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899931
    m_Localized: "C'\xE8 una nuova versione"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899932
    m_Localized: Impossibile verificare il tuo account
    m_Metadata:
      m_Items: []
  - m_Id: 7534899933
    m_Localized: "Il tuo account sta gi\xE0 giocando"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899934
    m_Localized: "La connessione \xE8 caduta"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899935
    m_Localized: Si uniscono solo giocatori con la stessa versione del gioco. Aggiorna dal launcher e cerca di nuovo.
    m_Metadata:
      m_Items: []
  - m_Id: 7534899936
    m_Localized: "La tua sessione \xE8 scaduta o \xE8 stata chiusa. Accedi di nuovo dal launcher e cerca ancora."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899937
    m_Localized: "Il tuo account \xE8 in quella partita da un altro PC. Chiudi il gioco l\xEC e cerca di nuovo."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899938
    m_Localized: 'Controlla internet e cerca di nuovo. Non hai perso nulla: i tuoi progressi sono salvati.'
    m_Metadata:
      m_Items: []
  - m_Id: 7534899939
    m_Localized: la tua regione
    m_Metadata:
      m_Items: []
  - m_Id: 7534899940
    m_Localized: Sudamerica
    m_Metadata:
      m_Items: []
