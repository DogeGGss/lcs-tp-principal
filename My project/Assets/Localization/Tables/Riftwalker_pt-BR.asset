    m_Localized: '     <color=#F3F4F6>Esc</color>  Voltar'
    m_Metadata:
      m_Items: []
  - m_Id: 7513927681
    m_Localized: "Provis\xF3rio"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927682
    m_Localized: "\xDAltimo escolhido"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927683
    m_Localized: "S\xF3 apar\xEAncia"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927684
    m_Localized: Sem habilidade
    m_Metadata:
      m_Items: []
  - m_Id: 7513927685
    m_Localized: "No Deathmatch n\xE3o h\xE1 habilidades"
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789416
    m_Localized: "Na Invas\xE3o n\xE3o h\xE1 habilidades"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927686
    m_Localized: "{0} \xB7 Recarga {1} s"
    m_Metadata:
      m_Items: []
