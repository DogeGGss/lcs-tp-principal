    m_Metadata:
      m_Items: []
  - m_Id: 7513927705
    m_Localized: "Modo Invas\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927706
    m_Localized: "Voc\xEA sobreviveu!"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927707
    m_Localized: "Voc\xEA foi eliminado"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927708
    m_Localized: Jogador
    m_Metadata:
      m_Items: []
  - m_Id: 7513927709
    m_Localized: "N\xE3o foi poss\xEDvel conectar. Confira sua conex\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927710
    m_Localized: "J\xE1 n\xE3o \xE9 poss\xEDvel voltar a essa partida."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927711
    m_Localized: "Invas\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927712
    m_Localized: "T\xE1tico"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927713
    m_Localized: Escolha seu equipamento
    m_Metadata:
      m_Items: []
  - m_Id: 7513927714
    m_Localized: "Come\xE7a em"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927715
    m_Localized: Feche para reaparecer
    m_Metadata:
      m_Items: []
  - m_Id: 7513927716
    m_Localized: "Voc\xEA pode trocar"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927717
    m_Localized: Lutem!
    m_Metadata:
      m_Items: []
  - m_Id: 7513927718
    m_Localized: "Modo Deathmatch  \xB7  S\xF3 muda a apar\xEAncia"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927719
    m_Localized: "Voc\xEA troca de equipamento ao morrer ou logo depois de reaparecer"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927720
    m_Localized: "Muni\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927721
    m_Localized: As duas armas
    m_Metadata:
      m_Items: []
  - m_Id: 7513927722
    m_Localized: Enche o carregador e a reserva das suas duas armas.
    m_Metadata:
      m_Items: []
