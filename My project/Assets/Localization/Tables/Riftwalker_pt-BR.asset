    m_Localized: "Enviamos um c\xF3digo de 6 n\xFAmeros para "
    m_Metadata:
      m_Items: []
  - m_Id: 7518122132
    m_Localized: ". Se n\xE3o encontrar, confira a caixa de spam."
    m_Metadata:
      m_Items: []
  - m_Id: 7518122133
    m_Localized: "N\xE3o chegou? Voc\xEA pode pedir outro em 0:{0:00}"
    m_Metadata:
      m_Items: []
