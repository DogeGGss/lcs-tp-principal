      m_Items: []
  - m_Id: 7534900034
    m_Localized: "Os valores desta aba voltam aos de f\xE1brica e s\xE3o salvos."
    m_Metadata:
      m_Items: []
  - m_Id: 7534900035
    m_Localized: "Mudan\xE7as salvas"
    m_Metadata:
      m_Items: []
