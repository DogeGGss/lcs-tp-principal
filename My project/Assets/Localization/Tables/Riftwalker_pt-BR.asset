    m_Metadata:
      m_Items: []
  - m_Id: 7513927803
    m_Localized: "Arma secund\xE1ria"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927804
    m_Localized: 'Rende com: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 7513927805
    m_Localized: 'Deixa sem uso: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 7513927806
    m_Localized: "Sem uso com Alimenta\xE7\xE3o direta"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927807
    m_Localized: "Substitui sua {0}. Vem com a muni\xE7\xE3o cheia."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927808
    m_Localized: "Vai no seu espa\xE7o de arma {0}, que est\xE1 vazio. Vem com a muni\xE7\xE3o cheia."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927809
    m_Localized: Escolha do posto
    m_Metadata:
      m_Items: []
  - m_Id: 7513927810
