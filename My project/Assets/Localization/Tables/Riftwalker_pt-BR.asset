    m_Metadata:
      m_Items: []
  - m_Id: 380227458789383
    m_Localized: "Primeiro sai a raridade (com estas probabilidades), depois o tipo ({0} % avatar, {1} % banner, {2} % t\xEDtulo, {3} % moldura, {4} % skin de arma) e por \xFAltimo um item ao acaso. A cada {5} c\xE1psulas h\xE1 um \xE9pico ou melhor garantido. Os repetidos viram cr\xE9ditos."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789384
    m_Localized: "{0} no espa\xE7o {1} ({2})"
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789385
