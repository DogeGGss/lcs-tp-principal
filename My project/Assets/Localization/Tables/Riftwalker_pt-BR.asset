    m_Metadata:
      m_Items: []
  - m_Id: 7518122103
    m_Localized: "Voc\xEA entra como {0}. Seu progresso fica na conta."
    m_Metadata:
      m_Items: []
  - m_Id: 7518122104
    m_Localized: "N\xE3o foi poss\xEDvel buscar atualiza\xE7\xF5es. Voc\xEA pode jogar com sua conta: o que jogar ser\xE1 enviado quando a conex\xE3o voltar."
