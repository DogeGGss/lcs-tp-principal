    m_Metadata:
      m_Items: []
  - m_Id: 7513927811
    m_Localized: "R  \xB7  Sortear de novo  \xB7  {0} pts"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927812
    m_Localized: "Voc\xEA tem {0} pts"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927813
    m_Localized: Faltam pontos para sortear de novo ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 7513927814
    m_Localized: Onda {0}
    m_Metadata:
      m_Items: []
  - m_Id: 7513927815
    m_Localized: "O chefe est\xE1 chegando"
    m_Metadata:
