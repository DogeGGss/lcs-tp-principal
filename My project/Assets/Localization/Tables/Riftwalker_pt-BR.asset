    m_Localized: Escolhido por {0}
    m_Metadata:
      m_Items: []
  - m_Id: 7513927688
    m_Localized: Vazio
    m_Metadata:
      m_Items: []
  - m_Id: 7513927689
    m_Localized: "Voc\xEA n\xE3o tem emotes equipados: equipe-os no seu perfil."
