    m_Metadata:
      m_Items: []
  - m_Id: 7534899674
    m_Localized: "Olho de falc\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899675
    m_Localized: Sniper da plataforma
    m_Metadata:
      m_Items: []
  - m_Id: 7534899676
    m_Localized: "Companheiro de vag\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899677
    m_Localized: "Primeira esta\xE7\xE3o"
    m_Metadata:
      m_Items: []
