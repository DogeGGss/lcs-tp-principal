  - m_Id: 7534899858
    m_Localized: "H\xE1 n\xE3o tanto tempo, em uma universidade\nmuito, muito pr\xF3xima\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899859
    m_Localized: "Um shooter t\xE1tico, um deathmatch e uma invas\xE3o alien\xEDgena na universidade. Feito por sete estudantes em dez semanas, com mais caf\xE9 do que horas de sono."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899860
    m_Localized: "Desenvolvimento e mec\xE2nicas"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899861
