  - m_Id: 7534899916
    m_Localized: "os gr\xE1ficos"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899917
    m_Localized: "Configura\xE7\xE3o gr\xE1fica restaurada para os valores padr\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899918
    m_Localized: Procurar partida
    m_Metadata:
      m_Items: []
  - m_Id: 7534899919
    m_Localized: " \xB7 com jogadores da sua regi\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899920
    m_Localized: "Sala privada \xB7 com amigos"
    m_Metadata:
      m_Items: []
