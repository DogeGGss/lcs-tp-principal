    m_Metadata:
      m_Items: []
  - m_Id: 7534899922
    m_Localized: "Entrar com c\xF3digo"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899923
    m_Localized: Procurar de novo
    m_Metadata:
      m_Items: []
  - m_Id: 7534899924
    m_Localized: Abrir o launcher
    m_Metadata:
      m_Items: []
  - m_Id: 7534899925
    m_Localized: Jogador
    m_Metadata:
      m_Items: []
  - m_Id: 7534899926
    m_Localized: Busca cancelada.
    m_Metadata:
      m_Items: []
  - m_Id: 7534899927
    m_Localized: "N\xE3o encontramos o launcher neste PC: abrimos o guia do jogo para voc\xEA baix\xE1-lo."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899928
    m_Localized: Cancelar busca
    m_Metadata:
      m_Items: []
  - m_Id: 7534899929
    m_Localized: Sair da sala
    m_Metadata:
      m_Items: []
  - m_Id: 7534899930
    m_Localized: Voltar aos modos
    m_Metadata:
      m_Items: []
  - m_Id: 7534899931
    m_Localized: "H\xE1 uma vers\xE3o nova"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899932
    m_Localized: "N\xE3o foi poss\xEDvel verificar sua conta"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899933
    m_Localized: "Sua conta j\xE1 est\xE1 jogando"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899934
    m_Localized: "A conex\xE3o caiu"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899935
    m_Localized: "S\xF3 se juntam jogadores com a mesma vers\xE3o do jogo. Atualize pelo launcher e procure de novo."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899936
    m_Localized: "Sua sess\xE3o expirou ou foi encerrada. Entre de novo no launcher e procure outra vez."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899937
    m_Localized: "Sua conta est\xE1 nessa partida a partir de outro PC. Feche o jogo l\xE1 e procure de novo."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899938
    m_Localized: "Verifique sua internet e procure de novo. Voc\xEA n\xE3o perdeu nada: seu progresso est\xE1 salvo."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899939
    m_Localized: "sua regi\xE3o"
    m_Metadata:
      m_Items: []
