    m_Metadata:
      m_Items: []
  - m_Id: 7534899533
    m_Localized: "N\xE3o foi poss\xEDvel recuperar a identidade online. O progresso local foi mantido."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899534
    m_Localized: "N\xE3o foi poss\xEDvel autenticar. Verifique o acesso an\xF4nimo do projeto."
