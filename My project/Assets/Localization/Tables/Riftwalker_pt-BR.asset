  - m_Id: 7534899992
    m_Localized: "  <color=#FFD2A1>\xB7 anfitri\xE3o</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899993
    m_Localized: "N\xE3o h\xE1 mapas para este modo"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899994
    m_Localized: "Esperando o anfitri\xE3o\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899995
    m_Localized: "Passe o c\xF3digo para seus amigos. S\xE3o necess\xE1rios pelo menos 2 jogadores."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899996
    m_Localized: 'Tudo pronto: inicie a partida quando quiser.'
