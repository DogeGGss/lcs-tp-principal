      m_Items: []
  - m_Id: 7509733376
    m_Localized: "<color=#F3F4F6>{0}</color>  Escolher     <color=#F3F4F6>\u2190 \u2192</color>  Mover     <color=#F3F4F6>Enter</color>  Confirmar"
    m_Metadata:
      m_Items: []
