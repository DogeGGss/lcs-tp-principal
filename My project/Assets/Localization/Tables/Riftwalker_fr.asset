    m_Localized: "<color=#F3F4F6>Entr\xE9e</color>  Valider     <color=#F3F4F6>\xC9chap</color>  Annuler"
    m_Metadata:
      m_Items: []
  - m_Id: 7534900069
    m_Localized: C'est ainsi que les autres joueurs te verront.
    m_Metadata:
      m_Items: []
  - m_Id: 7534900070
    m_Localized: Comment t'appelles-tu ?
    m_Metadata:
      m_Items: []
  - m_Id: 7534900071
    m_Localized: "Ton nom dans les salons, le tableau et les \xE9liminations."
    m_Metadata:
      m_Items: []
  - m_Id: 7534900072
    m_Localized: Ton nom
    m_Metadata:
      m_Items: []
  - m_Id: 7534900073
    m_Localized: "Il manque 1 caract\xE8re : le minimum est 3."
    m_Metadata:
      m_Items: []
