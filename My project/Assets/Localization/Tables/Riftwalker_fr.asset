    m_Metadata:
      m_Items: []
  - m_Id: 7534899376
    m_Localized: "R\xE9ception de la cargaison\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899377
    m_Localized: "Un billet, une capsule. Chacune contient un avatar, une banni\xE8re, un titre ou un cadre."
    m_Metadata:
      m_Items: []
