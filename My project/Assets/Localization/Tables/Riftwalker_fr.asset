    m_Localized: Retour
    m_Metadata:
      m_Items: []
  - m_Id: 7518122127
    m_Localized: "CR\xC9ATION\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122128
    m_Localized: 'C''est fait : ton compte est actif.'
    m_Metadata:
      m_Items: []
  - m_Id: 7518122129
    m_Localized: "TON COMPTE \xB7 ENCORE UNE \xC9TAPE"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122130
    m_Localized: CONFIRME TON E-MAIL
    m_Metadata:
      m_Items: []
  - m_Id: 7518122131
    m_Localized: "Nous avons envoy\xE9 un code \xE0 6 chiffres \xE0 "
    m_Metadata:
      m_Items: []
  - m_Id: 7518122132
    m_Localized: ". Si tu ne le vois pas, v\xE9rifie les spams."
    m_Metadata:
      m_Items: []
  - m_Id: 7518122133
    m_Localized: "Pas re\xE7u ? Tu pourras en demander un autre dans 0:{0:00}"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122134
    m_Localized: "Pas re\xE7u ? "
    m_Metadata:
      m_Items: []
