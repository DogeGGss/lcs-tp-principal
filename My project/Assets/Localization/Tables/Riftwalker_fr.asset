    m_Localized: "Tu reviens \xE0 la premi\xE8re vague et <color=#F29A38>la progression actuelle</color> est perdue."
    m_Metadata:
      m_Items: []
  - m_Id: 7534900047
    m_Localized: "Tu reviens au d\xE9but de la partie et <color=#F29A38>la progression actuelle</color> est perdue."
