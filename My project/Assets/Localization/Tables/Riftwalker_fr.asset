    m_Localized: Change-le
    m_Metadata:
      m_Items: []
  - m_Id: 7518122139
    m_Localized: CONFIRMER
    m_Metadata:
      m_Items: []
  - m_Id: 7518122140
    m_Localized: "CONFIRMATION\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122141
    m_Localized: "R\xC9CUP\xC9RER LE MOT DE PASSE"
    m_Metadata:
      m_Items: []
