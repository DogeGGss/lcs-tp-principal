    m_Metadata:
      m_Items: []
  - m_Id: 7518122119
    m_Localized: "CR\xC9ER UN COMPTE"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122120
    m_Localized: "Le compte part de z\xE9ro : il sauvegarde ta progression dans le cloud et te permet de jouer sur n'importe quel PC."
    m_Metadata:
      m_Items: []
  - m_Id: 7518122121
    m_Localized: "8 caract\xE8res ou plus"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122122
    m_Localized: "R\xC9P\xC8TE LE MOT DE PASSE"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122123
    m_Localized: Se connecter
    m_Metadata:
      m_Items: []
  - m_Id: 7518122124
    m_Localized: "En cr\xE9ant le compte, tu acceptes "
    m_Metadata:
      m_Items: []
  - m_Id: 7518122125
    m_Localized: "l'avis de confidentialit\xE9"
    m_Metadata:
      m_Items: []
