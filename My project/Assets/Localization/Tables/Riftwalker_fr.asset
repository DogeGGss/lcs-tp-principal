    m_Metadata:
      m_Items: []
  - m_Id: 7534899382
    m_Localized: "\u2022 EN ATTENTE"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899383
    m_Localized: "La prochaine contient <color=#B061FF>\xE9pique ou mieux</color> garanti !"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899384
    m_Localized: Tu n'as encore ouvert aucune capsule.
    m_Metadata:
      m_Items: []
  - m_Id: 7534899385
    m_Localized: "Aide-nous \xE0 nous am\xE9liorer"
    m_Metadata:
      m_Items: []
