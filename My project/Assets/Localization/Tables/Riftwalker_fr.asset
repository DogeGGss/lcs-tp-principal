    m_Localized: "Fl\xE8ches"
    m_Metadata:
      m_Items: []
  - m_Id: 7534900063
    m_Localized: Choisir et changer
    m_Metadata:
      m_Items: []
  - m_Id: 7534900064
    m_Localized: "De 3 \xE0 16 caract\xE8res : lettres, chiffres, espace, tiret et tiret bas."
    m_Metadata:
      m_Items: []
  - m_Id: 7534900065
    m_Localized: "Project Riftwalker \xB7 Joueur"
    m_Metadata:
      m_Items: []
