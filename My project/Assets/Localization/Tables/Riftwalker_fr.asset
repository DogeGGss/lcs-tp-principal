    m_Metadata:
      m_Items: []
  - m_Id: 380227458789394
    m_Localized: Point
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789395
    m_Localized: "Impossible de cr\xE9er le salon. V\xE9rifie ta connexion."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789396
    m_Localized: "Impossible de rejoindre le salon. V\xE9rifie ta connexion."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789397
    m_Localized: "Impossible de revenir dans la partie. V\xE9rifie ta connexion."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789398
    m_Localized: "Impossible de chercher une partie. V\xE9rifie ta connexion et cherche \xE0 nouveau."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789399
    m_Localized: "Ton compte est d\xE9j\xE0 dans cette partie, sur un autre PC."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789400
    m_Localized: "Tu figures encore dans la partie. R\xE9essaie dans quelques secondes."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789401
    m_Localized: "La partie est d\xE9j\xE0 termin\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789402
    m_Localized: Le salon est plein.
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789403
    m_Localized: "La partie a d\xE9j\xE0 commenc\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789404
    m_Localized: Ce salon est en {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789405
    m_Localized: "La connexion au serveur a \xE9t\xE9 perdue."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789406
    m_Localized: "Une nouvelle version est disponible ({0}). Mets \xE0 jour le jeu depuis le launcher pour jouer en ligne."
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789407
    m_Localized: Acheter
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789408
    m_Localized: Fermer
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789409
    m_Localized: "1 \xE0 4 joueurs"
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789410
    m_Localized: "Quai 3 \xB7 En ligne"
    m_Metadata:
      m_Items: []
  - m_Id: 380227458789411
    m_Localized: "De 1 \xE0 4 joueurs contre les vagues de l'universit\xE9. Toutes les 10 vagues arrive le Boss ; si vous l'abattez, vous pouvez continuer pour battre le record."
