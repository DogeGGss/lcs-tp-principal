    m_Localized: +1 billet
    m_Metadata:
      m_Items: []
  - m_Id: 7534899372
    m_Localized: +10 billets
    m_Metadata:
      m_Items: []
  - m_Id: 7534899373
    m_Localized: "Pas de cristaux ? Aller \xE0 la boutique \xBB"
