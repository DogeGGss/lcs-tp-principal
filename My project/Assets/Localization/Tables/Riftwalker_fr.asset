      m_Items: []
  - m_Id: 7534900034
    m_Localized: "Les valeurs de cet onglet reviennent aux r\xE9glages d'usine et sont enregistr\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 7534900035
    m_Localized: "Changements enregistr\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 7534900036
    m_Localized: "Entr\xE9e  Valider     \xC9chap  Annuler"
    m_Metadata:
      m_Items: []
  - m_Id: 7534900037
    m_Localized: La partie continue
    m_Metadata:
      m_Items: []
  - m_Id: 7534900038
