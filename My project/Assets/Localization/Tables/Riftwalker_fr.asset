    m_Metadata:
      m_Items: []
  - m_Id: 7518122111
    m_Localized: MOT DE PASSE
    m_Metadata:
      m_Items: []
  - m_Id: 7518122112
    m_Localized: "Mot de passe oubli\xE9 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122113
    m_Localized: "ENTRER  \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122114
