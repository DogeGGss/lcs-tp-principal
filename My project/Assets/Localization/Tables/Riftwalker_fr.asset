    m_Localized: Langue
    m_Metadata:
      m_Items: []
  - m_Id: 7534900075
    m_Localized: Langue du jeu
    m_Metadata:
      m_Items: []
  - m_Id: 7534900076
    m_Localized: "Le changement s'applique imm\xE9diatement et est partag\xE9 avec le launcher."
    m_Metadata:
      m_Items: []
