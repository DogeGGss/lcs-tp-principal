      m_Items: []
  - m_Id: 2872270592503819
    m_Localized: "Les 20 derni\xE8res parties termin\xE9es de ton compte, de la plus r\xE9cente \xE0 la plus ancienne."
    m_Metadata:
      m_Items: []
  - m_Id: 2872270592503820
    m_Localized: "Sans compte : seules les parties jou\xE9es sur cet ordinateur s'affichent."
    m_Metadata:
      m_Items: []
  - m_Id: 2872270592503821
    m_Localized: "Parties de cet ordinateur : le service en ligne doit \xEAtre mis \xE0 jour."
    m_Metadata:
      m_Items: []
  - m_Id: 2872270592503822
    m_Localized: "Hors ligne : parties de cet ordinateur. Elles seront envoy\xE9es sur ton compte au retour de la connexion."
    m_Metadata:
      m_Items: []
  - m_Id: 2872270592503823
    m_Localized: "Tu n'as encore termin\xE9 aucune partie. Elles apparaissent ici en arrivant \xE0 l'\xE9cran des r\xE9sultats."
    m_Metadata:
      m_Items: []
  - m_Id: 2872270592503824
    m_Localized: '{0} sur {1} parties'
    m_Metadata:
      m_Items: []
