    m_Localized: "Donn\xE9es de test r\xE9initialis\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899357
    m_Localized: "Achat simul\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899358
    m_Localized: "Acheter (simul\xE9)"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899359
    m_Localized: "Rien n'est factur\xE9 : c'est une simulation commerciale pour le TP."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899360
    m_Localized: "Tu l'as d\xE9j\xE0 achet\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899361
    m_Localized: "Avec un compte, pas de r\xE9initialisation"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899362
    m_Localized: "Tu n'as encore fait aucun achat simul\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899363
    m_Localized: "Ravitaillement de l'autre c\xF4t\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899364
    m_Localized: "Ouvrir 1 \xB7 1 billet"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899365
    m_Localized: "Ouvrir 5 \xB7 5 billets"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899366
    m_Localized: "En ouvrir une autre \xB7 1 billet"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899367
    m_Localized: "Probabilit\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899368
    m_Localized: Obtenir des billets
    m_Metadata:
      m_Items: []
  - m_Id: 7534899369
    m_Localized: 1 billet
    m_Metadata:
      m_Items: []
  - m_Id: 7534899370
    m_Localized: "10 billets \xB7 10 % de moins"
