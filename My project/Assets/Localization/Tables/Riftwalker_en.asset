    m_Metadata:
      m_Items: []
  - m_Id: 7518122119
    m_Localized: CREATE ACCOUNT
    m_Metadata:
      m_Items: []
  - m_Id: 7518122120
    m_Localized: 'Your new account starts fresh: save your progress to the cloud and play on any PC.'
    m_Metadata:
      m_Items: []
  - m_Id: 7518122121
    m_Localized: 8 characters or more
    m_Metadata:
      m_Items: []
  - m_Id: 7518122122
    m_Localized: REPEAT PASSWORD
    m_Metadata:
      m_Items: []
  - m_Id: 7518122123
    m_Localized: Sign in
    m_Metadata:
      m_Items: []
  - m_Id: 7518122124
    m_Localized: 'By creating an account you accept the '
    m_Metadata:
      m_Items: []
  - m_Id: 7518122125
    m_Localized: privacy notice
    m_Metadata:
      m_Items: []
  - m_Id: 7518122126
    m_Localized: Back
    m_Metadata:
      m_Items: []
  - m_Id: 7518122127
