    m_Localized: 'This is how your header looks in the Profile.

      The left side of the banner is kept for your avatar and your name.'
    m_Metadata:
      m_Items: []
  - m_Id: 7534899586
    m_Localized: "Get it at the station \xBB"
    m_Metadata:
      m_Items: []
