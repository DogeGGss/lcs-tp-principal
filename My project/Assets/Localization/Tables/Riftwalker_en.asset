  - m_Id: 7518122107
    m_Localized: YOUR ACCOUNT
    m_Metadata:
      m_Items: []
  - m_Id: 7518122108
    m_Localized: SIGN IN
    m_Metadata:
      m_Items: []
  - m_Id: 7518122109
    m_Localized: You need an account to play. Your progress is saved to it so you can continue on any PC.
    m_Metadata:
      m_Items: []
  - m_Id: 7518122110
    m_Localized: EMAIL
    m_Metadata:
      m_Items: []
  - m_Id: 7518122111
