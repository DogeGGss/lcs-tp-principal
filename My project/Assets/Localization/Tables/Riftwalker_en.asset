    m_Localized: "YOUR ACCOUNT \xB7 ONE MORE STEP"
    m_Metadata:
      m_Items: []
  - m_Id: 7518122130
    m_Localized: VERIFY YOUR EMAIL
    m_Metadata:
      m_Items: []
  - m_Id: 7518122131
    m_Localized: 'We sent a 6-digit code to '
    m_Metadata:
      m_Items: []
  - m_Id: 7518122132
    m_Localized: . If you cannot find it, check your spam folder.
    m_Metadata:
      m_Items: []
  - m_Id: 7518122133
    m_Localized: Did not receive it? Request another in 0:{0:00}
    m_Metadata:
      m_Items: []
  - m_Id: 7518122134
    m_Localized: 'Did not receive it? '
    m_Metadata:
      m_Items: []
  - m_Id: 7518122135
    m_Localized: Request another code
    m_Metadata:
      m_Items: []
