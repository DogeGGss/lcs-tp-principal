    m_Metadata:
      m_Items: []
  - m_Id: 7513927709
    m_Localized: "No se pudo conectar. Revis\xE1 tu conexi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927710
    m_Localized: Ya no se puede volver a esa partida.
    m_Metadata:
      m_Items: []
