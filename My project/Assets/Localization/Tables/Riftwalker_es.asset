  - m_Id: 7534899991
    m_Localized: Libre
    m_Metadata:
      m_Items: []
  - m_Id: 7534899992
    m_Localized: "  <color=#FFD2A1>\xB7 anfitri\xF3n</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899993
    m_Localized: No hay mapas para este modo
    m_Metadata:
      m_Items: []
  - m_Id: 7534899994
    m_Localized: "Esperando al anfitri\xF3n\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7534899995
    m_Localized: "Pasale el c\xF3digo a tus amigos. Se necesitan al menos 2 jugadores."
    m_Metadata:
      m_Items: []
  - m_Id: 7534899996
    m_Localized: "Todo listo: inici\xE1 la partida cuando quieras."
    m_Metadata:
      m_Items: []
