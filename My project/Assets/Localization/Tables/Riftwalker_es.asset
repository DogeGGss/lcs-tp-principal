      m_Items: []
  - m_Id: 7513927717
    m_Localized: "\xA1A pelear!"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927718
    m_Localized: "Modo Deathmatch  \xB7  Solo cambia el aspecto"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927719
    m_Localized: "Cambi\xE1s de equipo al morir o reci\xE9n reaparecido"
