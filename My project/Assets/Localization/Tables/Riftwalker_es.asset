    m_Metadata:
      m_Items: []
  - m_Id: 7518122103
    m_Localized: "Entr\xE1s como {0}. Tu progreso est\xE1 en la cuenta."
    m_Metadata:
      m_Items: []
  - m_Id: 7518122104
    m_Localized: "No se pudo buscar actualizaciones. Pod\xE9s jugar con tu cuenta: lo que juegues se sube cuando vuelva la conexi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7518122105
