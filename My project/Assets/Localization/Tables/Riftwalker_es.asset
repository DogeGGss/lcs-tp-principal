      m_Items: []
  - m_Id: 7513927821
    m_Localized: JEFE DERROTADO
    m_Metadata:
      m_Items: []
  - m_Id: 7513927822
    m_Localized: "Superaste la oleada {0}. Si segu\xEDs, te espera la elecci\xF3n del Jefe, pero desde ahora los invasores tienen {1} % m\xE1s de vida y pegan {2} % m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927823
    m_Localized: "Pr\xF3xima oleada en"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927824
    m_Localized: "Pr\xF3xima oleada"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927825
