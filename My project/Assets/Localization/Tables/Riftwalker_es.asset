  - m_Id: 7513927805
    m_Localized: 'Deja sin uso: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 7513927806
    m_Localized: "Sin uso con Alimentaci\xF3n directa"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927807
    m_Localized: "Reemplaza a tu {0}. Viene con la munici\xF3n llena."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927808
    m_Localized: "Va en tu espacio de arma {0}, que est\xE1 vac\xEDo. Viene con la munici\xF3n llena."
    m_Metadata:
      m_Items: []
  - m_Id: 7513927809
    m_Localized: "Elecci\xF3n del puesto"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927810
    m_Localized: "Eleg\xED una"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927811
    m_Localized: "R  \xB7  Volver a tirar  \xB7  {0} pts"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927812
    m_Localized: "Ten\xE9s {0} pts"
    m_Metadata:
      m_Items: []
  - m_Id: 7513927813
    m_Localized: Te faltan puntos para volver a tirar ({0})
    m_Metadata:
      m_Items: []
