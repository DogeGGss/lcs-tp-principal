      m_Items: []
  - m_Id: 7534900030
    m_Localized: "\xBFGuardar los cambios?"
    m_Metadata:
      m_Items: []
  - m_Id: 7534900031
    m_Localized: "Hay cambios sin aplicar. Si sal\xEDs sin guardarlos, se pierden."
    m_Metadata:
      m_Items: []
