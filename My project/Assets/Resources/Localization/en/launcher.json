    {
      "key": "launcher.privacy_what",
      "text": "WHAT WE STORE"
    },
    {
      "key": "launcher.privacy_what_body",
      "text": "Your email and password (encrypted), your name, your progress (achievements, cosmetics and currency), your match statistics and the feedback you send."
    },
    {
      "key": "launcher.privacy_why",
      "text": "WHY"
    },
    {
      "key": "launcher.privacy_why_body",
      "text": "To recover your progress on any PC, for the global rankings and for matchmaking. We do not use it for advertising or share it with anyone."
    },
    {
      "key": "launcher.privacy_where",
      "text": "WHERE"
    },
    {
      "key": "launcher.privacy_where_body",
      "text": "In the game database (Supabase). Matches use Photon servers, which receive your player name, account ID and connection (IP address)."
    },
    {
      "key": "launcher.privacy_rights",
      "text": "YOUR RIGHTS"
    },
    {
      "key": "launcher.privacy_rights_body",
      "text": "You can view your data in your in-game Profile and delete your account and its data from this launcher (Argentine Personal Data Protection Law 25.326)."
    },
