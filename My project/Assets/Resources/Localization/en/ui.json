    {
      "key": "ui.source.06bea83f1caa",
      "text": "One team plants the device at A or B while the other defends. No respawns: if you die, spectate a teammate until the next round."
    },
    {
      "key": "ui.source.2cd59b33d55d",
      "text": "Free-for-all. Choose your weapons for free, heal 50 health per kill, and respawn after 3 seconds away from opponents."
    },
    {
      "key": "ui.source.edb1f952e2fd",
      "text": "Face 10 waves alone at university. Then continue in endless mode to set a new record."
    },
    {
      "key": "ui.source.b7003361f10e",
      "text": "Switch sides in round 6"
    },
    {
      "key": "ui.source.90106cd60e43",
      "text": "20 s buy phase"
    },
    {
      "key": "ui.source.3d67d2e48cb3",
