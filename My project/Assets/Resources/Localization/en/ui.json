    },
    {
      "key": "ui.source.33e166676072",
      "text": "Waiting for the host  ·  the match starts when they finish loading"
    },
    {
      "key": "ui.source.5cd100bc1db8",
      "text": "Waiting for other players  ·  the match starts when everyone has loaded"
    },
    {
      "key": "ui.source.cf73b31f016a",
      "text": "Crouch with {Agacharse} before shooting to reduce bullet spread."
    },
    {
      "key": "ui.source.964d0a404f4a",
      "text": "Reload with {Recargar} before peeking, before the shooting starts."
    },
    {
      "key": "ui.source.f7c33a1f57bf",
      "text": "Moving increases bullet spread. Stop before shooting."
    },
    {
      "key": "ui.source.7c9a7aa1ce00",
      "text": "Headshots deal more damage."
    },
    {
      "key": "ui.source.c1a37bc01675",
      "text": "Use your character ability with {Habilidad}."
    },
    {
      "key": "ui.source.53fffdfafbc1",
      "text": "Change key bindings, sensitivity and your crosshair in Options or the pause menu."
    },
    {
      "key": "ui.source.1507bc1df18f",
      "text": "Hold Tab to view the scoreboard."
    },
    {
      "key": "ui.source.f57ccbe15609",
      "text": "Hold {Plantar} at a site to plant the device. Moving cancels planting."
    },
    {
      "key": "ui.source.f590c58c9fcc",
      "text": "Open the shop with {Tienda} during the buy phase while inside your base."
    },
    {
      "key": "ui.source.d736f2d6cc07",
      "text": "Drop your weapon with {Soltar} to give it to a teammate."
    },
    {
      "key": "ui.source.0d04ac611154",
      "text": "If you carry the device, equip it with {Dispositivo}."
    },
    {
      "key": "ui.source.00deb0ea7e50",
      "text": "You respawn at the start of the next round. Stay alive."
    },
    {
      "key": "ui.source.3c81f53a7dc9",
      "text": "Losing consecutive rounds gives you more money for the next one."
    },
    {
      "key": "ui.source.0f540b9fc332",
      "text": "Defenders defuse the device by holding {Plantar} beside it."
    },
    {
      "key": "ui.source.a4a36b824a8a",
      "text": "You respawn after a few seconds in Deathmatch. Keep moving."
    },
    {
      "key": "ui.source.a44b4e91fd74",
      "text": "Switch weapons with {ArmaPrincipal}, {ArmaSecundaria} and {Cuchillo}."
    },
    {
      "key": "ui.source.19a717d04b63",
      "text": "Each wave is harder than the last. Save your ammo."
    },
    {
      "key": "ui.source.32359472c07f",
      "text": "If enemies surround you, switch to your knife with {Cuchillo} instead of reloading."
    },
