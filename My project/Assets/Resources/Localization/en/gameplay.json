    {
      "key": "gameplay.card.fx.reserve_shot",
      "text": "With an empty magazine, holding the trigger keeps firing from the reserve at half the fire rate."
    },
    {
      "key": "gameplay.card.fx.focused_shot",
      "text": "While aiming, the rifle fires up to 5 bullets together in a single hit, every 0.4 s."
    },
    {
      "key": "gameplay.card.fx.quick_discharge",
      "text": "Charged shot: holding the trigger charges in 3 stages and, on release, fires 2, 4 or 6 bullets in a row."
    },
    {
      "key": "gameplay.card.fx.coupling",
      "text": "Every 3 pistol hits, your primary weapon fires one shot on its own toward the crosshair."
    },
    {
      "key": "gameplay.card.fx.no_backup",
      "text": "Your primary weapon gets double the magazine, but you lose your secondary for the rest of the match."
    },
    {
      "key": "gameplay.card.fx.sticky_charge",
      "text": "Grenades that hit an invader directly stick to it for 1 s and explode with double damage."
    },
    {
      "key": "gameplay.card.fx.double_shell",
      "text": "The shotgun fires 2 shells at once, using both."
    },
    {
      "key": "gameplay.card.fx.compact_slug",
      "text": "While aiming, the pellets fly together as a single projectile with no spread and the same damage."
    },
    {
      "key": "gameplay.card.fx.twin_mag",
      "text": "The first time the magazine runs empty, it reloads instantly from the reserve."
    },
    {
      "key": "gameplay.card.fx.loose_bolt",
      "text": "After a headshot kill, you can fire again after 0.2 s."
    },
    {
      "key": "gameplay.card.fx.open_sights",
      "text": "Without aiming, it fires with no spread and at double the fire rate. While aiming, it fires normally."
    },
    {
      "key": "gameplay.card.fx.no_interval",
      "text": "Killing removes the pause between the next 3 bursts."
    },
    {
      "key": "gameplay.card.fx.no_interval.2",
      "text": "Killing removes the pause between the next 5 bursts."
    },
    {
      "key": "gameplay.card.fx.no_interval.3",
      "text": "Killing removes the pause between the next 7 bursts."
    },
    {
      "key": "gameplay.card.fx.growing_burst",
      "text": "Each kill adds one bullet to your bursts, up to 6. Reloading resets them to 3."
    },
    {
      "key": "gameplay.card.fx.growing_burst.2",
      "text": "Each kill adds one bullet to your bursts, up to 8. Reloading resets them to 3."
    },
    {
      "key": "gameplay.card.fx.growing_burst.3",
      "text": "Each kill adds one bullet to your bursts, up to 10. Reloading resets them to 3."
    },
    {
      "key": "gameplay.card.fx.minefield",
      "text": "Grenades that touch the ground stay as mines (up to 5)."
    },
    {
      "key": "gameplay.card.fx.minefield.2",
      "text": "Grenades that touch the ground stay as mines (up to 7)."
    },
    {
      "key": "gameplay.card.fx.minefield.3",
      "text": "Grenades that touch the ground stay as mines (up to 9)."
    },
    {
      "key": "gameplay.card.fx.logistics",
      "text": "From now on, stations refill all your ammo instead of half."
    },
    {
      "key": "gameplay.card.fx.backpack",
      "text": "40% more reserve ammo for both weapons."
    },
    {
      "key": "gameplay.card.fx.backpack.2",
      "text": "80% more reserve ammo for both weapons (40% more than now)."
    },
    {
      "key": "gameplay.card.fx.backpack.3",
      "text": "120% more reserve ammo for both weapons (40% more than now)."
    },
    {
      "key": "gameplay.card.fx.recycler",
      "text": "Each headshot kill returns 5 bullets to the magazine."
    },
    {
      "key": "gameplay.card.fx.recycler.2",
      "text": "Each headshot kill returns 10 bullets to the magazine."
    },
    {
      "key": "gameplay.card.fx.recycler.3",
      "text": "Each headshot kill returns 15 bullets to the magazine."
    },
    {
      "key": "gameplay.card.fx.edge",
      "text": "Knife kills reload the last weapon you held."
    },
    {
      "key": "gameplay.card.fx.scavenger",
      "text": "1 in 5 invaders drops a magazine when it dies."
    },
    {
      "key": "gameplay.card.fx.scavenger.2",
      "text": "1 in 4 invaders drops a magazine when it dies."
    },
    {
      "key": "gameplay.card.fx.scavenger.3",
      "text": "1 in 3 invaders drops a magazine when it dies."
    },
    {
      "key": "gameplay.card.fx.finisher",
      "text": "The knife kills invaders with 25% health or less in one hit (except the Boss)."
    },
    {
      "key": "gameplay.card.fx.finisher.2",
      "text": "The knife kills invaders with 30% health or less in one hit (except the Boss)."
    },
    {
      "key": "gameplay.card.fx.finisher.3",
      "text": "The knife kills invaders with 35% health or less in one hit (except the Boss)."
    },
    {
      "key": "gameplay.card.fx.hungry_edge",
      "text": "Each knife hit heals as much as the damage it deals, up to 25 health per hit."
    },
    {
      "key": "gameplay.card.fx.hungry_edge.2",
      "text": "Each knife hit heals as much as the damage it deals, up to 35 health per hit."
    },
    {
      "key": "gameplay.card.fx.hungry_edge.3",
      "text": "Each knife hit heals as much as the damage it deals, up to 45 health per hit."
    },
    {
      "key": "gameplay.card.fx.ready_reserve",
      "text": "Your holstered weapon reloads itself from its reserve after 2 s."
    },
    {
      "key": "gameplay.card.fx.rage",
      "text": "When an invader hits you, your next shot adds 5 times the health you lost."
    },
    {
      "key": "gameplay.card.fx.rage.2",
      "text": "When an invader hits you, your next shot adds 6 times the health you lost."
    },
    {
      "key": "gameplay.card.fx.rage.3",
      "text": "When an invader hits you, your next shot adds 7 times the health you lost."
    },
    {
      "key": "gameplay.card.fx.direct_feed",
      "text": "Magazine and reserve are a single pool: you never reload until you run out of bullets."
    },
    {
      "key": "gameplay.card.fx.instant_delivery",
      "text": "The station's choice opens as soon as it's charged, without waiting for the wave to end."
    },
    {
      "key": "gameplay.card.fx.clearance",
      "text": "When the station is charged, a bubble pushes invaders in the ring back 10 m, except the Boss."
    },
    {
      "key": "gameplay.card.fx.clearance.2",
      "text": "When the station is charged, a bubble pushes invaders in the ring back 15 m, except the Boss."
    },
    {
      "key": "gameplay.card.fx.clearance.3",
      "text": "When the station is charged, a bubble pushes invaders in the ring back 20 m, except the Boss."
    },
