    },
    {
      "key": "ui.source.33e166676072",
      "text": "En attente de l'hôte  ·  la partie commence une fois le chargement terminé"
    },
    {
      "key": "ui.source.5cd100bc1db8",
      "text": "En attente des autres joueurs  ·  la partie commence quand tout le monde a chargé"
    },
    {
      "key": "ui.source.cf73b31f016a",
      "text": "Accroupis-toi avec {Agacharse} avant de tirer : les balles dévient moins."
    },
    {
      "key": "ui.source.964d0a404f4a",
      "text": "Recharge avec {Recargar} avant de te montrer, pas en pleine fusillade."
    },
    {
      "key": "ui.source.f7c33a1f57bf",
      "text": "Tirer en mouvement augmente la dispersion : arrête-toi avant de tirer."
    },
    {
      "key": "ui.source.7c9a7aa1ce00",
      "text": "Les tirs à la tête font plus de dégâts."
    },
    {
      "key": "ui.source.c1a37bc01675",
      "text": "Utilise la compétence de ton personnage avec {Habilidad}."
    },
    {
      "key": "ui.source.53fffdfafbc1",
      "text": "Les touches, la sensibilité et le viseur se modifient dans Options ou depuis la pause."
    },
    {
      "key": "ui.source.1507bc1df18f",
      "text": "Maintiens la touche Tab pour voir le tableau des joueurs."
    },
    {
      "key": "ui.source.f57ccbe15609",
      "text": "Maintiens {Plantar} sur une zone pour poser le dispositif. Si tu bouges, ça s'interrompt."
    },
    {
      "key": "ui.source.f590c58c9fcc",
      "text": "Ouvre la boutique avec {Tienda} pendant la phase d'achat, dans ta base."
    },
    {
      "key": "ui.source.d736f2d6cc07",
      "text": "Lâche ton arme avec {Soltar} pour la passer à un coéquipier."
    },
    {
      "key": "ui.source.0d04ac611154",
      "text": "Si tu portes le dispositif, sors-le avec {Dispositivo}."
    },
    {
      "key": "ui.source.00deb0ea7e50",
      "text": "En mourant, tu ne réapparais qu'à la manche suivante : fais attention à ta vie."
    },
    {
      "key": "ui.source.3c81f53a7dc9",
      "text": "Perdre plusieurs manches d'affilée donne plus d'argent pour la suivante."
    },
    {
      "key": "ui.source.0f540b9fc332",
      "text": "Les défenseurs désamorcent le dispositif en maintenant {Plantar} à côté."
    },
    {
      "key": "ui.source.a4a36b824a8a",
      "text": "En Deathmatch, tu réapparais en quelques secondes : ne reste pas immobile."
    },
    {
      "key": "ui.source.a44b4e91fd74",
      "text": "Change d'arme avec {ArmaPrincipal}, {ArmaSecundaria} et {Cuchillo}."
    },
    {
      "key": "ui.source.19a717d04b63",
      "text": "Chaque vague est plus difficile que la précédente : économise tes balles."
    },
    {
      "key": "ui.source.32359472c07f",
      "text": "Si tu es encerclé, passe au couteau avec {Cuchillo} au lieu de recharger."
    },
