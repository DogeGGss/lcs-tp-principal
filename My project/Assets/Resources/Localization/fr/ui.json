    },
    {
      "key": "ui.source.0ef0a6e6fd62",
      "text": "C'est ainsi que les autres joueurs te verront."
    },
    {
      "key": "ui.source.a1ef9fe3a6b0",
      "text": "Comment t'appelles-tu ?"
    },
