    },
    {
      "key": "ui.source.50716d4cbd8d",
      "text": "Une nouvelle version est disponible"
    },
    {
      "key": "ui.source.1e290698f084",
      "text": "Impossible de vérifier ton compte"
    },
    {
      "key": "ui.source.20812e99701a",
      "text": "Ton compte est déjà en jeu"
    },
    {
      "key": "ui.source.29aaabb5e604",
      "text": "La connexion a été coupée"
    },
    {
      "key": "ui.source.811dc87efeed",
      "text": "Seuls les joueurs ayant la même version du jeu sont réunis. Mets à jour depuis le launcher et cherche à nouveau."
    },
    {
      "key": "ui.source.785ca8f737f7",
      "text": "Ta session a expiré ou a été fermée. Reconnecte-toi dans le launcher et cherche à nouveau."
    },
    {
      "key": "ui.source.0a536de09daa",
      "text": "Ton compte est dans cette partie depuis un autre PC. Ferme le jeu là-bas et cherche à nouveau."
    },
    {
      "key": "ui.source.906b58a64933",
      "text": "Vérifie ta connexion et cherche à nouveau. Tu n'as rien perdu : ta progression est enregistrée."
    },
    {
      "key": "ui.source.9648dfdc9eb4",
      "text": "ta région"
    },
