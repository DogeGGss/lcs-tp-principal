    },
    {
      "key": "ui.source.9c573aa510ad",
      "text": "Si quelqu'un d'autre arrive, il rejoint. Si quelqu'un part et qu'il reste moins que le minimum, la recherche continue."
    },
    {
      "key": "ui.source.93fffbf7ce79",
      "text": "Quitter"
    },
    {
      "key": "ui.source.a64249139d0d",
      "text": "Tactique"
    },
