    {
      "key": "launcher.privacy_what_body",
      "text": "La tua e-mail e la password (cifrata), il tuo nome, i progressi (obiettivi, cosmetici e monete), le statistiche di partita e le opinioni che invii."
    },
    {
      "key": "launcher.privacy_why",
      "text": "A COSA SERVE"
    },
    {
      "key": "launcher.privacy_why_body",
      "text": "Per recuperare i progressi su qualsiasi PC, per la classifica globale e per cercare partita. Non li usiamo per la pubblicità né li condividiamo con nessuno."
    },
    {
      "key": "launcher.privacy_where",
      "text": "DOVE"
    },
    {
      "key": "launcher.privacy_where_body",
      "text": "Nel database del gioco (Supabase). Le partite passano dai server di Photon, che ricevono il tuo nome giocatore, l'id dell'account e la connessione (IP)."
    },
    {
      "key": "launcher.privacy_rights",
      "text": "I TUOI DIRITTI"
    },
    {
      "key": "launcher.privacy_rights_body",
      "text": "Puoi vedere i tuoi dati nel Profilo del gioco ed eliminare l'account con tutto il suo contenuto da questo launcher (legge argentina 25.326 sulla protezione dei dati personali)."
    },
