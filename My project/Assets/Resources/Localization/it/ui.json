    },
    {
      "key": "ui.source.33e166676072",
      "text": "In attesa dell'host  ·  la partita inizia quando finisce di caricare"
    },
    {
      "key": "ui.source.5cd100bc1db8",
      "text": "In attesa degli altri giocatori  ·  la partita inizia quando hanno caricato tutti"
    },
    {
      "key": "ui.source.cf73b31f016a",
      "text": "Accovacciati con {Agacharse} prima di sparare: i proiettili deviano meno."
    },
    {
      "key": "ui.source.964d0a404f4a",
      "text": "Ricarica con {Recargar} prima di sporgerti, non in mezzo alla sparatoria."
    },
    {
      "key": "ui.source.f7c33a1f57bf",
      "text": "Sparare in movimento aumenta la dispersione: fermati prima di sparare."
    },
    {
      "key": "ui.source.7c9a7aa1ce00",
      "text": "I colpi alla testa fanno più danni."
    },
    {
      "key": "ui.source.c1a37bc01675",
      "text": "Usa l'abilità del tuo personaggio con {Habilidad}."
    },
    {
      "key": "ui.source.53fffdfafbc1",
      "text": "Tasti, sensibilità e mirino si cambiano in Opzioni o dalla pausa."
    },
    {
      "key": "ui.source.1507bc1df18f",
      "text": "Tieni premuto Tab per vedere la tabella dei giocatori."
    },
    {
      "key": "ui.source.f57ccbe15609",
      "text": "Tieni premuto {Plantar} su una zona per piazzare il dispositivo. Se ti muovi, si interrompe."
    },
    {
      "key": "ui.source.f590c58c9fcc",
      "text": "Apri il negozio con {Tienda} durante la fase di acquisto, dentro la tua base."
    },
    {
      "key": "ui.source.d736f2d6cc07",
      "text": "Lascia la tua arma con {Soltar} per passarla a un compagno."
    },
    {
      "key": "ui.source.0d04ac611154",
      "text": "Se porti il dispositivo, tiralo fuori con {Dispositivo}."
    },
    {
      "key": "ui.source.00deb0ea7e50",
      "text": "Quando muori non ricompari fino al round successivo: attento alla vita."
    },
    {
      "key": "ui.source.3c81f53a7dc9",
      "text": "Perdere più round di fila dà più soldi per il successivo."
    },
    {
      "key": "ui.source.0f540b9fc332",
      "text": "I difensori disinnescano il dispositivo tenendo premuto {Plantar} accanto."
    },
    {
      "key": "ui.source.a4a36b824a8a",
      "text": "Nel Deathmatch ricompari dopo pochi secondi: non stare fermo."
    },
    {
      "key": "ui.source.a44b4e91fd74",
      "text": "Cambia arma con {ArmaPrincipal}, {ArmaSecundaria} e {Cuchillo}."
    },
    {
      "key": "ui.source.19a717d04b63",
      "text": "Ogni ondata è più difficile della precedente: risparmia i proiettili."
    },
    {
      "key": "ui.source.32359472c07f",
      "text": "Se ti circondano, passa al coltello con {Cuchillo} invece di ricaricare."
    },
