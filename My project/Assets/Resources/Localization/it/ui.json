      "text": "Caricamento della mappa…"
    },
    {
      "key": "ui.source.f4cb1ffad13c",
      "text": "Connessione al server…"
    },
    {
      "key": "ui.source.7860f97d560d",
      "text": " <color=#FFFFFF80>(tu)</color>"
    },
    {
      "key": "ui.source.82d69149e2c1",
      "text": "Ricerca…"
    },
    {
      "key": "ui.source.9c573aa510ad",
      "text": "Se entra qualcun altro, si unisce. Se qualcuno esce e restano meno del minimo, la ricerca continua."
    },
    {
      "key": "ui.source.93fffbf7ce79",
      "text": "Esci"
    },
    {
      "key": "ui.source.a64249139d0d",
      "text": "Tattico"
    },
    {
      "key": "ui.source.af61688462fc",
      "text": "Invasione"
    },
    {
      "key": "ui.source.feec439bd19e",
      "text": "Piazza o disinnesca il dispositivo. Senza ricomparsa."
    },
    {
      "key": "ui.source.622cc159ad92",
      "text": "Tutti contro tutti. Ricompari dopo 3 s."
    },
    {
      "key": "ui.source.db0595d76630",
      "text": "Resisti all'invasione all'università."
    },
    {
      "key": "ui.source.3142609f3640",
