      "key": "ui.source.8ae5261402b3",
      "text": "Cerca partita"
    },
    {
      "key": "ui.source.aab7f54dacbc",
      "text": " · con giocatori della tua regione"
    },
    {
      "key": "ui.source.b30593eb5232",
      "text": "Stanza privata · con amici"
    },
    {
      "key": "ui.source.2750bd2f99ad",
      "text": "Crea stanza"
    },
    {
      "key": "ui.source.ce6fc7dc8eaf",
      "text": "Entra con codice"
    },
    {
      "key": "ui.source.e616c2466dc7",
      "text": "Cerca di nuovo"
    },
    {
      "key": "ui.source.f674d306a0c6",
      "text": "Apri il launcher"
    },
    {
      "key": "ui.source.e47ce2a916e0",
      "text": "Giocatore"
    },
    {
      "key": "ui.source.8215d0adeaa3",
      "text": "Ricerca annullata."
    },
    {
      "key": "ui.source.351d2bbeeffa",
      "text": "Non abbiamo trovato il launcher su questo PC: ti apriamo la guida del gioco per scaricarlo."
    },
    {
      "key": "ui.source.66b0e5784678",
      "text": "Annulla ricerca"
    },
    {
      "key": "ui.source.ceabcf3eef35",
      "text": "Esci dalla stanza"
    },
    {
      "key": "ui.source.fabab14234b2",
      "text": "Torna alle modalità"
    },
    {
      "key": "ui.source.50716d4cbd8d",
      "text": "C'è una nuova versione"
    },
    {
      "key": "ui.source.1e290698f084",
      "text": "Impossibile verificare il tuo account"
    },
    {
      "key": "ui.source.20812e99701a",
      "text": "Il tuo account sta già giocando"
    },
    {
      "key": "ui.source.29aaabb5e604",
      "text": "La connessione è caduta"
    },
    {
      "key": "ui.source.811dc87efeed",
      "text": "Si uniscono solo giocatori con la stessa versione del gioco. Aggiorna dal launcher e cerca di nuovo."
    },
    {
      "key": "ui.source.785ca8f737f7",
      "text": "La tua sessione è scaduta o è stata chiusa. Accedi di nuovo dal launcher e cerca ancora."
    },
    {
      "key": "ui.source.0a536de09daa",
      "text": "Il tuo account è in quella partita da un altro PC. Chiudi il gioco lì e cerca di nuovo."
    },
    {
      "key": "ui.source.906b58a64933",
      "text": "Controlla internet e cerca di nuovo. Non hai perso nulla: i tuoi progressi sono salvati."
    },
    {
      "key": "ui.source.9648dfdc9eb4",
      "text": "la tua regione"
    },
    {
      "key": "ui.source.4de82dfd7d3b",
