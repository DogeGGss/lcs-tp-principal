    {
      "key": "gameplay.card.fx.reserve_shot",
      "text": "Con el cargador vacío, manteniendo el gatillo sigue disparando desde la reserva, a la mitad de la cadencia."
    },
    {
      "key": "gameplay.card.fx.focused_shot",
      "text": "Apuntando, el fusil dispara hasta 5 balas juntas en un solo impacto, cada 0,4 s."
    },
    {
      "key": "gameplay.card.fx.quick_discharge",
      "text": "Disparo cargado: manteniendo el gatillo se carga en 3 etapas y, al soltar, salen 2, 4 o 6 balas seguidas."
    },
    {
      "key": "gameplay.card.fx.coupling",
      "text": "Cada 3 tiros de pistola que aciertan, el arma principal dispara sola un tiro hacia la mira."
    },
    {
      "key": "gameplay.card.fx.no_backup",
      "text": "Tu arma principal tiene el doble de cargador, pero perdés la secundaria por el resto de la partida."
    },
    {
      "key": "gameplay.card.fx.sticky_charge",
      "text": "Las granadas que le pegan directo a un invasor se le pegan 1 s y explotan con el doble de daño."
    },
    {
      "key": "gameplay.card.fx.double_shell",
      "text": "La escopeta dispara 2 cartuchos juntos, gastando los dos."
    },
    {
      "key": "gameplay.card.fx.compact_slug",
      "text": "Apuntando, los perdigones salen juntos en un solo proyectil sin dispersión, con el mismo daño."
    },
    {
      "key": "gameplay.card.fx.twin_mag",
      "text": "La primera vez que se vacía el cargador, se recarga al instante desde la reserva."
    },
    {
      "key": "gameplay.card.fx.loose_bolt",
      "text": "Después de una baja a la cabeza, se puede volver a disparar a los 0,2 s."
    },
    {
      "key": "gameplay.card.fx.open_sights",
      "text": "Sin apuntar, dispara sin dispersión y al doble de cadencia. Apuntando, dispara normal."
    },
    {
      "key": "gameplay.card.fx.no_interval",
      "text": "Matar saca la pausa entre las próximas 3 ráfagas."
    },
    {
      "key": "gameplay.card.fx.growing_burst",
      "text": "Cada baja le suma una bala a las ráfagas, hasta 6. Al recargar vuelven a 3."
    },
    {
      "key": "gameplay.card.fx.minefield",
      "text": "Las granadas que tocan el piso quedan como minas (hasta 5)."
    },
    {
      "key": "gameplay.card.fx.logistics",
      "text": "Desde ahora, los puestos recargan toda la munición en vez de la mitad."
    },
    {
      "key": "gameplay.card.fx.backpack",
      "text": "40 % más de reserva en las dos armas."
    },
    {
      "key": "gameplay.card.fx.recycler",
      "text": "Cada baja a la cabeza devuelve 5 balas al cargador."
    },
    {
      "key": "gameplay.card.fx.edge",
      "text": "Matar con el cuchillo recarga la última arma que tuviste en la mano."
    },
    {
      "key": "gameplay.card.fx.scavenger",
      "text": "1 de cada 5 invasores suelta un cargador al morir."
    },
    {
      "key": "gameplay.card.fx.finisher",
      "text": "El cuchillo mata de un golpe a los invasores con 25 % de vida o menos (salvo al Jefe)."
    },
    {
      "key": "gameplay.card.fx.hungry_edge",
      "text": "Cada cuchillazo cura lo mismo que el daño que hace, hasta 25 de vida por golpe."
    },
    {
      "key": "gameplay.card.fx.ready_reserve",
      "text": "El arma guardada se recarga sola desde su reserva después de 2 s."
    },
    {
      "key": "gameplay.card.fx.rage",
      "text": "Cuando un invasor te pega, tu próximo disparo suma 5 veces la vida que perdiste."
    },
    {
      "key": "gameplay.card.fx.direct_feed",
      "text": "El cargador y la reserva son un solo depósito: no recargás nunca, hasta que se acaban las balas."
    },
    {
      "key": "gameplay.card.fx.instant_delivery",
      "text": "La elección del puesto se abre apenas se carga, sin esperar a que termine la oleada."
    },
    {
      "key": "gameplay.card.fx.clearance",
      "text": "Cuando el puesto se carga, una burbuja empuja 10 m a los invasores del anillo, salvo al Jefe."
    },
