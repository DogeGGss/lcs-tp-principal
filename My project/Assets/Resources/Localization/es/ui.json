    },
    {
      "key": "ui.source.feec439bd19e",
      "text": "Plantá o desactivá el dispositivo. Sin reaparición."
    },
    {
      "key": "ui.source.622cc159ad92",
      "text": "Todos contra todos. Reaparecés a los 3 s."
    },
