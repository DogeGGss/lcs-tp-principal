    {
      "key": "ui.source.acabc2c4f4c8",
      "text": "Modo Invasión"
    },
    {
      "key": "ui.source.90797c7dce81",
      "text": "Sala "
    },
    {
      "key": "ui.source.33e166676072",
      "text": "Esperando al anfitrión  ·  la partida empieza cuando termine de cargar"
    },
    {
      "key": "ui.source.5cd100bc1db8",
      "text": "Esperando a los demás jugadores  ·  la partida empieza cuando cargaron todos"
    },
    {
      "key": "ui.source.cf73b31f016a",
      "text": "Agachate con {Agacharse} antes de tirar: las balas se desvían menos."
    },
    {
      "key": "ui.source.964d0a404f4a",
      "text": "Recargá con {Recargar} antes de asomarte, no en medio del tiroteo."
    },
    {
      "key": "ui.source.f7c33a1f57bf",
      "text": "Disparar en movimiento abre la dispersión: frená antes de tirar."
    },
    {
      "key": "ui.source.7c9a7aa1ce00",
      "text": "Los tiros a la cabeza hacen más daño."
    },
    {
      "key": "ui.source.c1a37bc01675",
      "text": "Usá la habilidad de tu personaje con {Habilidad}."
    },
    {
      "key": "ui.source.53fffdfafbc1",
      "text": "Las teclas, la sensibilidad y la mira se cambian en Opciones o desde la pausa."
    },
    {
      "key": "ui.source.1507bc1df18f",
      "text": "Mantené apretada la tecla Tab para ver la tabla de jugadores."
    },
    {
      "key": "ui.source.f57ccbe15609",
      "text": "Mantené apretada {Plantar} sobre una zona para plantar el dispositivo. Si te movés, se corta."
    },
    {
      "key": "ui.source.f590c58c9fcc",
      "text": "Abrí la tienda con {Tienda} durante la fase de compra, dentro de tu base."
    },
    {
      "key": "ui.source.d736f2d6cc07",
      "text": "Soltá tu arma con {Soltar} para pasársela a un compañero."
    },
    {
      "key": "ui.source.0d04ac611154",
      "text": "Si llevás el dispositivo, sacalo con {Dispositivo}."
    },
    {
      "key": "ui.source.00deb0ea7e50",
      "text": "Al morir no reaparecés hasta la ronda siguiente: cuidá la vida."
    },
    {
      "key": "ui.source.3c81f53a7dc9",
      "text": "Perder varias rondas seguidas da más plata para la siguiente."
    },
    {
      "key": "ui.source.0f540b9fc332",
      "text": "Los defensores desactivan el dispositivo manteniendo apretada {Plantar} al lado."
    },
    {
      "key": "ui.source.a4a36b824a8a",
      "text": "En Deathmatch reaparecés a los pocos segundos: no te quedes quieto."
    },
    {
      "key": "ui.source.a44b4e91fd74",
      "text": "Cambiá de arma con {ArmaPrincipal}, {ArmaSecundaria} y {Cuchillo}."
    },
    {
      "key": "ui.source.19a717d04b63",
      "text": "Cada oleada es más difícil que la anterior: guardá balas."
    },
    {
      "key": "ui.source.32359472c07f",
      "text": "Si te rodean, pasá al cuchillo con {Cuchillo} en vez de recargar."
    },
