      "text": "Volver a los modos"
    },
    {
      "key": "ui.source.50716d4cbd8d",
      "text": "Hay una versión nueva"
    },
    {
      "key": "ui.source.1e290698f084",
      "text": "No se pudo verificar tu cuenta"
    },
    {
      "key": "ui.source.20812e99701a",
      "text": "Tu cuenta ya está jugando"
    },
    {
      "key": "ui.source.29aaabb5e604",
      "text": "Se cortó la conexión"
    },
    {
      "key": "ui.source.811dc87efeed",
      "text": "Solo se juntan jugadores con la misma versión del juego. Actualizá desde el launcher y volvé a buscar."
    },
    {
      "key": "ui.source.785ca8f737f7",
      "text": "Tu sesión venció o se cerró. Volvé a entrar en el launcher y buscá de nuevo."
    },
    {
      "key": "ui.source.0a536de09daa",
      "text": "Tu cuenta está en esa partida desde otra PC. Cerrá el juego ahí y volvé a buscar."
    },
    {
      "key": "ui.source.906b58a64933",
      "text": "Revisá tu internet y volvé a buscar. No perdiste nada: tu progreso está guardado."
    },
    {
      "key": "ui.source.9648dfdc9eb4",
      "text": "tu región"
    },
