    {
      "key": "ui.source.79e4cac1daa9",
      "text": "Al mover un control suena una muestra. Se guarda al apretar Aplicar."
    },
    {
      "key": "ui.source.81cf595bb929",
      "text": "el sonido"
    },
    {
      "key": "ui.source.416e91fcab21",
